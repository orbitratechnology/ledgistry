# Copy to .env.local and fill in. Placeholders only — never commit real values.

# App
APP_URL=http://localhost:3000
APP_MODE=development

# Supabase (public by design: URL + publishable/anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Airwallex — Sandbox only for the MVP
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_SANDBOX_ONLY=true
# Optional: pin a different API version (defaults to 2026-08-21)
# AIRWALLEX_API_VERSION=2026-08-21

# Optional: comma-separated operator emails allowed into the workspace (empty = any signed-in user)
LEDGISTRY_OPERATOR_EMAILS=

# Anthropic via Vercel AI SDK (used from Phase 3)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-haiku-5-5

# Playwright e2e (a test operator in your dev Supabase project)
E2E_OPERATOR_EMAIL=
E2E_OPERATOR_PASSWORD=
